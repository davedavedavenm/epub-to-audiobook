APP_VERSION=1.3.0
APP_GIT_SHA=unknown
APP_BUILD_TIME=unknown
STACK_PATH=/path/to/epub-to-audiobook
PIPER_IMAGE=ghcr.io/matatonic/openedai-speech-min:latest
QUEUE_RUNNER_ENABLED=1

# Integration settings
AUDIOBOOKSHELF_DIR=/opt/stacks/audiobookshelf/audiobooks
AUDIOBOOKSHELF_HOST=docker-vm
AUDIOBOOKSHELF_USER=dave
AUDIOBOOKSHELF_PORT=
LIBRARY_DIR=/mnt/openbooks
EVOLUTION_API_URL=http://your-evolution-api-host:8084
EVOLUTION_API_KEY=
DEFAULT_WHATSAPP_NUMBER=

# LLM (OpenAI-compatible) — OPTIONAL, enables the smart chapter guard (auto-picks
# the real book body, skipping copyright pages / notes / index) and adaptive
# pronunciation. Without a key the app falls back to a deterministic heuristic,
# so everything still works. You can set this here or in the Settings UI.
#   Free & recommended — Groq:
#     LLM_API_BASE_URL=https://api.groq.com/openai/v1
#     LLM_MODEL_NAME=llama-3.3-70b-versatile   (key from https://console.groq.com)
#   Free — Google Gemini:
#     LLM_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#     LLM_MODEL_NAME=gemini-2.0-flash          (key from https://aistudio.google.com)
LLM_API_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL_NAME=gpt-4o-mini

# Health tuning
HEALTH_KOKORO_TIMEOUT=8
HEALTH_KOKORO_RETRIES=2
LOG_DIR=/data/logs

# Inworld TTS 1.5 (premium voices; likely above the normal GBP3/book target for full books)
# Get your key at https://inworld.ai/tts-api
INWORLD_API_KEY=
