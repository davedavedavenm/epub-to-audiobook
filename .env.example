APP_VERSION=2.1.0
APP_GIT_SHA=unknown
APP_BUILD_TIME=unknown
STACK_PATH=/path/to/epub-to-audiobook
QUEUE_RUNNER_ENABLED=1
MAX_CONCURRENT_JOBS=1

# Comma-separated hostnames/IPs accepted by Flask (no ports). LAN access is
# intentionally passwordless; protect any public hostname with Pangolin SSO.
APP_TRUSTED_HOSTS=localhost,127.0.0.1,audio.example.com
# Canonical public origin used in RSS channel/enclosure URLs behind a proxy.
PUBLIC_BASE_URL=https://audio.example.com

# TTS engine URLs (defaults match docker-compose service names)
KOKORO_URL=http://kokoro-tts:8880/v1
CHATTERBOX_URL=http://chatterbox-tts:8004/v1
TADA_URL=http://tada-tts:8005/v1
VIBEVOICE_URL=http://vibevoice-tts:8010/v1
VIBEVOICE_CFG_SCALE=2.0
QWEN3_URL=http://qwen3-tts:8011/v1
POCKET_URL=http://pocket-tts:8012/v1
KITTEN_URL=http://kitten-tts:8013/v1
GEMINI_TTS_URL=http://gemini-tts:8014/v1
# Optional proxy for transcript capture / Edge/Polly/Inworld routing
TTS_PROXY_URL=

# Integration settings
AUDIOBOOKSHELF_DIR=/opt/stacks/audiobookshelf/audiobooks
AUDIOBOOKSHELF_HOST=docker-vm
AUDIOBOOKSHELF_USER=dave
AUDIOBOOKSHELF_PORT=
ABS_API_TOKEN=
ABS_API_URL=http://docker-vm:13378
LIBRARY_DIR=/mnt/openbooks
EVOLUTION_API_URL=http://your-evolution-api-host:8084
EVOLUTION_API_KEY=
DEFAULT_WHATSAPP_NUMBER=

# LLM (OpenAI-compatible) — OPTIONAL, enables the smart chapter guard (auto-picks
# the real book body, skipping copyright pages / notes / index) and metadata.
# Generated pronunciation guesses are disabled by default. Without a key the
# app falls back to deterministic rules, so everything still works. You can set
# this here or in the Settings UI.
#   Groq (free-plan limits available; Developer usage is billed):
#     LLM_API_BASE_URL=https://api.groq.com/openai/v1
#     LLM_MODEL_NAME=openai/gpt-oss-120b       (key from https://console.groq.com)
#     Official model/deprecation lists:
#       https://console.groq.com/docs/models
#       https://console.groq.com/docs/deprecations
#     Do not use llama-3.3-70b-versatile: Groq shuts it down on 2026-08-16.
#   Free — Google Gemini:
#     LLM_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#     LLM_MODEL_NAME=gemini-2.0-flash          (key from https://aistudio.google.com)
LLM_API_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL_NAME=gpt-4o-mini

# Gemini 3.1 Flash TTS — accepted FREE-TIER-ONLY engine. Achernar passed the
# long-form gate; all 30 official presets can be cached for audition. Create this key
# in a dedicated Google AI Studio project whose Plan column says Free. Do not
# link that project to Cloud Billing. The adapter has no paid fallback and
# stops on quota exhaustion. After checking the Plan visually, set
# GEMINI_FREE_PROJECT_CONFIRMED=1; this is an operator assertion because the
# inference API does not report billing tier. Never commit the real key.
# Full setup and safety procedure: GEMINI-SETUP.md
GEMINI_API_KEY=
GEMINI_FREE_PROJECT_ID=
GEMINI_FREE_PROJECT_CONFIRMED=0
GEMINI_TTS_STYLE=
GEMINI_REQUEST_TIMEOUT=300
# Migration/recovery only: if enabling the persistent usage ledger after this
# project already made requests today, seed the conservative Pacific-day count.
# Leave blank/zero on a new install. Never use this to subtract real usage.
GEMINI_USAGE_BOOTSTRAP_PACIFIC_DATE=
GEMINI_USAGE_BOOTSTRAP_COUNT=0

# Local Ollama (OpenAI-compatible) — OPTIONAL, only used to phrase the pre-sync
# quality gate's "held for review" explanation. The gate's decision is
# deterministic; without this it still holds broken renders, just with the raw
# per-chapter reason. Point at any Ollama box, e.g.:
#   OLLAMA_URL=http://192.168.1.143:11434/v1
#   OLLAMA_MODEL=qwen2.5:3b
OLLAMA_URL=
OLLAMA_MODEL=qwen2.5:3b

# Notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Set this same value as Telegram setWebhook(secret_token=...).
TELEGRAM_WEBHOOK_SECRET=

# GPU render (Vast.ai) — OFF by default. See GPU-SAFETY.md before enabling.
GPU_RENDER_ENABLED=0
AUTOSCALE_COST_CAP=1.00
# Runtime secret file, mode 0600 and readable by container UID 999. Never commit.
VASTAI_API_KEY_PATH=/path/to/epub-to-audiobook/.secrets/vast_api_key

# Kaggle free GPU render (optional — per-book "Render on: Kaggle GPU")
KAGGLE_API_TOKEN=
KAGGLE_USERNAME=

# Optional services. deploy.sh always enables Chatterbox Nano because it owns
# the default narrator. Heavy CPU and CUDA families stay explicit opt-ins.
ENABLE_CHATTERBOX_PROFILE=0
ENABLE_TADA_PROFILE=0
ENABLE_MELOTTS_PROFILE=0
ENABLE_OMNIVOICE_PROFILE=0
ENABLE_CHATTERBOX_V3_PROFILE=0
ENABLE_VIBEVOICE_PROFILE=0
ENABLE_QWEN3_PROFILE=0
ENABLE_POCKET_PROFILE=0
ENABLE_KITTEN_PROFILE=0
ENABLE_GEMINI_PROFILE=0
POCKET_CPUS=4.0
POCKET_THREADS=4
KITTEN_CPUS=4.0
KITTEN_THREADS=4

# ASR verification (optional — sampled Whisper check after conversion)
AUDIO_ASR_VERIFY_ENABLED=0

# Cloud / Paid engine credentials (optional)
DEEPGRAM_API_KEY=
INWORLD_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Health tuning
HEALTH_KOKORO_TIMEOUT=8
HEALTH_KOKORO_RETRIES=2
LOG_DIR=/data/logs

# Voice previews: healthy free/local families warm in a load-throttled,
# skip-existing background task. Paid/network engines are never auto-called.
# Set to 0 on a constrained host.
VOICE_CACHE_ON_START=1
VOICE_CACHE_MAX_LOAD=
VOICE_CACHE_DELAY=5
